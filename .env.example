# ---------------------------------------------------------------------------
# Configuration backend (FastAPI). Copier en `.env` puis adapter.
# ---------------------------------------------------------------------------

# Hote / port du serveur local
FP_HOST=0.0.0.0
FP_PORT=8010

# URLs publiques. LAISSER VIDE EN LOCAL : elles sont alors construites toutes
# seules depuis l'IP LAN detectee (http://192.168.x.x:8010 et .../app), ce qui est
# la seule chose qu'un telephone puisse joindre. `localhost` ne veut rien dire
# depuis un autre appareil.
# A renseigner uniquement en production.
FP_PUBLIC_API_URL=
FP_PUBLIC_APP_URL=

# Exemple en production :
# FP_PUBLIC_API_URL=https://final-presentation.onrender.com
# FP_PUBLIC_APP_URL=https://ma-presentation.netlify.app

# Origines autorisees pour CORS (liste separee par des virgules, "*" pour tout)
FP_CORS_ORIGINS=*

# Code admin pour piloter la session depuis le deck (ouvrir/fermer un sondage, etc.)
FP_ADMIN_TOKEN=loreal2026

# Reinitialiser l'etat en memoire au demarrage (true/false)
FP_RESET_ON_START=true
